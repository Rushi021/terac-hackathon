# ---- Core (required) ----
# Supabase Postgres (Supabase dashboard → Connect → ORMs → Prisma).
# Pooled connection used by the app at runtime (port 6543):
DATABASE_URL="postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Direct connection used for schema changes (port 5432):
DIRECT_URL="postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Any long random string; signs login sessions. Generate: openssl rand -hex 32
AUTH_SECRET=""
# Public URL of this app. Terac study links and Whop redirects are built from it,
# so it must be a public HTTPS URL (e.g. ngrok) when running real studies/payments.
APP_URL="http://localhost:3000"

# ---- LLM used for business profiling, question generation and answer parsing ----
# Without it the audit still runs crawl checks and heuristic profiling, but skips
# question generation quality and entity ranking falls back to citation order.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# ---- AI answer engines queried for visibility (enable any subset) ----
# OpenAI web search uses OPENAI_API_KEY above.
ENGINE_OPENAI_ENABLED="true"
OPENAI_SEARCH_MODEL="gpt-4.1-mini"
PERPLEXITY_API_KEY=""
PERPLEXITY_MODEL="sonar"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# ---- Search demand (monthly volume). Without it volumes are shown as unavailable. ----
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# ---- Audit tuning ----
AUDIT_MAX_QUESTIONS="8"
AUDIT_MAX_PAGES="8"

# ---- Whop (payments) ----
WHOP_API_KEY=""
WHOP_COMPANY_ID=""
WHOP_PLAN_ID=""
WHOP_WEBHOOK_SECRET=""
# Audit credits granted per successful payment
WHOP_CREDITS_PER_PAYMENT="10"

# ---- Terac (human feedback) ----
TERAC_API_KEY=""
TERAC_PROJECT_ID=""
# Comma-separated emails allowed to use /admin (study management)
ADMIN_EMAILS=""
